# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
# Canonical origin, used for sitemap/robots/canonical/OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Payload owns the `cms` schema, Prisma owns the `app` schema. Both point at
# the same database so a single backup covers everything.
DATABASE_URI=postgres://kianbehsaz:kianbehsaz@localhost:5432/kianbehsaz
DATABASE_URL=postgres://kianbehsaz:kianbehsaz@localhost:5432/kianbehsaz?schema=app

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
# openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Cache revalidation
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate (called by Payload change hooks).
REVALIDATE_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Salt used to hash submitter IPs before they are stored. Rotating this salt
# makes previously stored hashes unlinkable.
IP_HASH_SALT=change-me-as-well
